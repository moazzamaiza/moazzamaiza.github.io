    <!-- JS Logic -->
    <script>
        // Tab Switcher for AP CSP Documentation
        function switchTab(projectId, tabName) {
            // Hide both content blocks
            document.getElementById(`content-${projectId}-overview`).classList.add('hidden');
            document.getElementById(`content-${projectId}-code`).classList.add('hidden');
            
            // Show selected block
            document.getElementById(`content-${projectId}-${tabName}`).classList.remove('hidden');

            // Reset tab button states
            const buttons = document.querySelectorAll(`.tab-btn-${projectId}`);
            buttons.forEach(btn => {
                btn.classList.remove('bg-white', `text-pastel${projectId === 'decision' ? 'Purple' : 'Pink'}-400`, 'shadow-sm');
                btn.classList.add('text-slate-500');
            });

            // Highlight chosen button
            const activeBtn = document.getElementById(`tab-${projectId}-${tabName}`);
            activeBtn.classList.remove('text-slate-500');
            activeBtn.classList.add('bg-white', `text-pastel${projectId === 'decision' ? 'Purple' : 'Pink'}-400`, 'shadow-sm');
        }

        // Custom Bow Preview Editor variables
        const leftLoop = document.getElementById('bow-left-loop');
        const rightLoop = document.getElementById('bow-right-loop');
        const leftTail = document.getElementById('bow-left-tail');
        const rightTail = document.getElementById('bow-right-tail');
        const bowCenter = document.getElementById('bow-center');
        const previewWrapper = document.getElementById('bow-preview-wrapper');

        // Modify color configurations
        function changeBowColor(loopColor, tailColor, knotColor) {
            leftLoop.setAttribute('fill', loopColor);
            rightLoop.setAttribute('fill', loopColor);
            leftTail.setAttribute('fill', tailColor);
            rightTail.setAttribute('fill', tailColor);
            bowCenter.setAttribute('fill', knotColor);
        }

        // Switch shape states
        function changeBowStyle(style) {
            if (style === 'classic') {
                leftTail.style.display = 'block';
                rightTail.style.display = 'block';
                leftLoop.setAttribute('d', 'M50 50 C30 20, 10 30, 20 50 C30 70, 45 60, 50 50 Z');
                rightLoop.setAttribute('d', 'M50 50 C70 20, 90 30, 80 50 C70 70, 55 60, 50 50 Z');
            } else if (style === 'no-tails') {
                leftTail.style.display = 'none';
                rightTail.style.display = 'none';
                leftLoop.setAttribute('d', 'M50 50 C30 20, 10 30, 20 50 C30 70, 45 60, 50 50 Z');
                rightLoop.setAttribute('d', 'M50 50 C70 20, 90 30, 80 50 C70 70, 55 60, 50 50 Z');
            } else if (style === 'sleek') {
                leftTail.style.display = 'block';
                rightTail.style.display = 'block';
                // Flatter loops
                leftLoop.setAttribute('d', 'M50 50 C25 35, 15 35, 20 50 C25 65, 45 55, 50 50 Z');
                rightLoop.setAttribute('d', 'M50 50 C75 35, 85 35, 80 50 C75 65, 55 55, 50 50 Z');
            }
        }

        // Alter float speed modifier
        function changeFloatIntensity(value) {
            previewWrapper.style.transition = 'all 0.5s ease-out';
            if (value === "0") {
                previewWrapper.style.animation = 'none';
            } else if (value === "1") {
                previewWrapper.style.animation = 'float 6s ease-in-out infinite';
            } else if (value === "2") {
                previewWrapper.style.animation = 'float 3s ease-in-out infinite';
            } else if (value === "3") {
                previewWrapper.style.animation = 'float 1.5s ease-in-out infinite';
            }
        }

        // Apply default floating logic to preview wrapper
        previewWrapper.style.animation = 'float 6s ease-in-out infinite';

        // Add Sweet Comment Form Submission Handler
        function addMessage(event) {
            event.preventDefault();
            const name = document.getElementById('form-name').value;
            const badge = document.getElementById('form-badge').value;
            const text = document.getElementById('form-text').value;

            const list = document.getElementById('guestbook-list');
            
            const commentBlock = document.createElement('div');
            // Alternates styling dynamically
            const isPink = list.children.length % 2 === 0;
            const bgClass = isPink ? 'bg-pastelPink-50/50 border-pastelPink-100' : 'bg-pastelPurple-50/50 border-pastelPurple-100';
            const badgeBorderClass = isPink ? 'border-pastelPink-200' : 'border-pastelPurple-200';

            commentBlock.className = `${bgClass} p-5 rounded-2xl border shadow-sm transition-transform hover:scale-[1.01] transform scale-95 opacity-0 duration-300`;
            commentBlock.innerHTML = `
                <div class="flex items-center justify-between mb-2">
                    <span class="font-bold text-slate-800 text-sm">${escapeHtml(name)} ✨</span>
                    <span class="text-xs text-slate-400 font-semibold bg-white px-2 py-0.5 rounded-full border ${badgeBorderClass}">${escapeHtml(badge)}</span>
                </div>
                <p class="text-slate-600 text-sm italic">
                    "${escapeHtml(text)}"
                </p>
            `;

            list.appendChild(commentBlock);

            // Trigger enter animation sequence
            setTimeout(() => {
                commentBlock.classList.remove('scale-95', 'opacity-0');
                commentBlock.classList.add('scale-100', 'opacity-100');
            }, 50);

            // Clean inputs
            document.getElementById('form-name').value = '';
            document.getElementById('form-text').value = '';
        }

        // Simple security helper
        function escapeHtml(text) {
            return text
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>
